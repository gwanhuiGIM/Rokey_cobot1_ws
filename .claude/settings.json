{
  "permissions": {
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo rm:*)",
      "Read(./.env)",
      "Read(./**/*credentials*)"
    ],
    "ask": [
      "Bash(ros2 launch:*)",
      "Bash(ros2 run:*)",
      "Bash(ros2 service call:*)",
      "Bash(git push:*)",
      "Bash(pip install:*)",
      "Bash(sudo:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh" }
        ]
      }
    ]
  }
}
